{
  "type": "excalidraw",
  "version": 2,
  "source": "medvet-arch-tool",
  "elements": [
    {
      "id": "title-doc",
      "type": "text",
      "x": 600,
      "y": 30,
      "text": "MEDVET — MODELO Y ESQUEMA DE BASE DE DATOS (11 ENTIDADES)",
      "fontSize": 24,
      "fontFamily": 3,
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "subtitle-doc",
      "type": "text",
      "x": 620,
      "y": 65,
      "text": "Arquitectura Relacional PostgreSQL / Knex / FeathersJS — EHR & Guardia 24/7",
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-users",
      "type": "rectangle",
      "x": 50,
      "y": 120,
      "width": 280,
      "height": 260,
      "backgroundColor": "#e7f5ff",
      "strokeColor": "#1971c2",
      "label": {
        "text": "USERS (Usuarios)\n-------------------------\n🔑 id : UUID (PK)\n📧 email : VARCHAR (UQ)\n🔒 password : VARCHAR (Hash)\n👤 name : VARCHAR\n📞 phone : VARCHAR\n🎭 role : ENUM ('admin', 'vet'...)\n⚡ active : BOOLEAN (true)\n⏱️ created_at : TIMESTAMP\n⏱️ updated_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-professionals",
      "type": "rectangle",
      "x": 420,
      "y": 120,
      "width": 280,
      "height": 200,
      "backgroundColor": "#ebfbee",
      "strokeColor": "#2f9e44",
      "label": {
        "text": "PROFESSIONALS (Especialistas)\n-------------------------\n🔑 id : UUID (PK)\n🔗 user_id : UUID (FK->users.id, UQ)\n🩺 specialty : VARCHAR\n⚡ active : BOOLEAN (true)\n⏱️ created_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-schedules",
      "type": "rectangle",
      "x": 780,
      "y": 120,
      "width": 280,
      "height": 200,
      "backgroundColor": "#ebfbee",
      "strokeColor": "#2f9e44",
      "label": {
        "text": "SCHEDULES (Horarios / Turnos)\n-------------------------\n🔑 id : UUID (PK)\n🔗 professional_id : UUID (FK->prof.)\n📅 day_of_week : INT (0-6)\n⏰ start_time : TIME\n⏰ end_time : TIME\n⚡ active : BOOLEAN (true)"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-shift-handovers",
      "type": "rectangle",
      "x": 1140,
      "y": 120,
      "width": 300,
      "height": 260,
      "backgroundColor": "#ffe8cc",
      "strokeColor": "#d9480f",
      "label": {
        "text": "SHIFT_HANDOVERS (Pase Guardia 24/7)\n-------------------------\n🔑 id : UUID (PK)\n🔗 outgoing_doctor_id : UUID (FK->prof.)\n🔗 incoming_doctor_id : UUID (FK->prof.)\n🚨 shift_type : ENUM ('guardia_24h'...)\n📅 shift_date : DATE\n🏥 admitted_patients_count : INT\n🔪 surgeries_count : INT\n🚨 emergencies_count : INT\n✅ discharges_count : INT\n⚠️ critical_patients_notes : TEXT\n📌 pending_tasks : TEXT"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-pets",
      "type": "rectangle",
      "x": 50,
      "y": 450,
      "width": 280,
      "height": 270,
      "backgroundColor": "#fff4e6",
      "strokeColor": "#e8590c",
      "label": {
        "text": "PETS (Mascotas / Pacientes)\n-------------------------\n🔑 id : UUID (PK)\n🔗 user_id : UUID (FK->users.id)\n🐾 name : VARCHAR\n🐕 species : VARCHAR\n🧬 breed : VARCHAR\n🎂 age : INT\n⚖️ weight : DECIMAL(5,2)\n🖼️ photo : VARCHAR\n⏱️ created_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-appointments",
      "type": "rectangle",
      "x": 420,
      "y": 420,
      "width": 300,
      "height": 300,
      "backgroundColor": "#f3d9fa",
      "strokeColor": "#9c36b5",
      "label": {
        "text": "APPOINTMENTS (Citas Médicas)\n-------------------------\n🔑 id : UUID (PK)\n🔗 user_id : UUID (FK->users.id)\n🔗 pet_id : UUID (FK->pets.id)\n🔗 professional_id : UUID (FK->prof.)\n🔗 service_id : UUID (FK->services.id)\n📅 date : DATE\n⏰ start_time : TIME\n⏰ end_time : TIME\n📊 status : ENUM ('pending', 'confirmed'...)\n📋 notes : TEXT\n⏱️ created_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-services",
      "type": "rectangle",
      "x": 780,
      "y": 420,
      "width": 280,
      "height": 250,
      "backgroundColor": "#e3fafc",
      "strokeColor": "#0c8599",
      "label": {
        "text": "SERVICES (Catálogo Clínico)\n-------------------------\n🔑 id : UUID (PK)\n📋 name : VARCHAR\n📝 description : TEXT\n⏳ duration : INT (Minutos)\n💵 price : DECIMAL(10,2) (USD)\n🏷️ category : ENUM ('consulta'...)\n⚡ active : BOOLEAN (true)\n⏱️ created_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-vaccinations",
      "type": "rectangle",
      "x": 50,
      "y": 790,
      "width": 300,
      "height": 280,
      "backgroundColor": "#e3fafc",
      "strokeColor": "#1098ad",
      "label": {
        "text": "VACCINATIONS (Carnet QR)\n-------------------------\n🔑 id : UUID (PK)\n🔗 pet_id : UUID (FK->pets.id)\n🔗 professional_id : UUID (FK->prof.)\n💉 vaccine_name : VARCHAR\n🏷️ type : ENUM ('vacuna', 'desparasitacion'...)\n📦 batch_number : VARCHAR\n🏢 manufacturer : VARCHAR\n📅 applied_date : DATE\n📅 next_due_date : DATE\n📊 status : ENUM ('aplicada', 'pendiente')"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-medical-records",
      "type": "rectangle",
      "x": 420,
      "y": 790,
      "width": 320,
      "height": 330,
      "backgroundColor": "#e6fcf5",
      "strokeColor": "#0ca678",
      "label": {
        "text": "MEDICAL_RECORDS (Historia Clínica EHR)\n-------------------------\n🔑 id : UUID (PK)\n🔗 pet_id : UUID (FK->pets.id)\n🔗 professional_id : UUID (FK->prof.)\n🔗 appointment_id : UUID (FK->appt.)\n🏷️ record_type : ENUM ('consulta', 'urgencia'...)\n📝 reason_for_visit : TEXT\n⚖️ weight_kg / temp / hr / rr : DECIMAL/INT\n👄 mucous_membranes / crt : VARCHAR\n📖 anamnesis / findings : TEXT\n🔬 presumptive / definitive diag : TEXT\n💊 treatment_plan / prescription : TEXT\n📊 patient_status : ENUM ('estable', 'critico'...)"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-clinical-attachments",
      "type": "rectangle",
      "x": 800,
      "y": 790,
      "width": 300,
      "height": 280,
      "backgroundColor": "#fff9db",
      "strokeColor": "#f08c00",
      "label": {
        "text": "CLINICAL_ATTACHMENTS (Visor RX & Lab)\n-------------------------\n🔑 id : UUID (PK)\n🔗 pet_id : UUID (FK->pets.id)\n🔗 medical_record_id : UUID (FK->med_rec)\n🔗 uploaded_by : UUID (FK->users.id)\n🩻 title : VARCHAR\n📁 category : ENUM ('radiografia', 'ecografia'...)\n🌐 file_url : VARCHAR\n🖼️ thumbnail_url : VARCHAR\n📝 findings : TEXT\n📅 study_date : DATE"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
    {
      "id": "tbl-surgeries",
      "type": "rectangle",
      "x": 1160,
      "y": 790,
      "width": 300,
      "height": 280,
      "backgroundColor": "#f8f0fc",
      "strokeColor": "#ae3ec9",
      "label": {
        "text": "SURGERIES (Quirófano & Protocolos)\n-------------------------\n🔑 id : UUID (PK)\n🔗 pet_id : UUID (FK->pets.id)\n🔗 professional_id : UUID (FK->prof.)\n🔗 medical_record_id : UUID (FK->med_rec)\n🔪 surgery_name : VARCHAR\n🏷️ surgery_type : ENUM ('programada'...)\n🩺 pre_op_evaluation (ASA) : TEXT\n💉 anesthesia_protocol : TEXT\n🔪 surgical_technique : TEXT\n🛌 post_op_orders : TEXT\n📊 status : ENUM ('programada', 'completada')"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T02:52:16.904Z",
      "updatedAt": "2026-08-15T02:52:16.904Z",
      "version": 1
    },
