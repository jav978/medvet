    {
      "id": "tbl-users",
      "type": "rectangle",
      "x": 80,
      "y": 140,
      "width": 300,
      "height": 280,
      "backgroundColor": "#e7f5ff",
      "strokeColor": "#1971c2",
      "label": {
        "text": "USERS (Usuarios)\n-------------------------\n🔑 id : UUID (PK)\n📧 email : VARCHAR (UQ)\n🔒 password : VARCHAR (Hash)\n👤 name : VARCHAR\n📞 phone : VARCHAR\n🎭 role : ENUM ('admin', 'vet'...)\n⚡ active : BOOLEAN (true)\n⏱️ created_at : TIMESTAMP\n⏱️ updated_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T00:24:46.882Z",
      "updatedAt": "2026-08-15T00:24:46.882Z",
      "version": 1
    },
    {
      "id": "tbl-professionals",
      "type": "rectangle",
      "x": 500,
      "y": 140,
      "width": 300,
      "height": 220,
      "backgroundColor": "#ebfbee",
      "strokeColor": "#2f9e44",
      "label": {
        "text": "PROFESSIONALS (Especialistas)\n-------------------------\n🔑 id : UUID (PK)\n🔗 user_id : UUID (FK->users.id, UQ)\n🩺 specialty : VARCHAR\n⚡ active : BOOLEAN (true)\n⏱️ created_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T00:24:46.882Z",
      "updatedAt": "2026-08-15T00:24:46.882Z",
      "version": 1
    },
    {
      "id": "tbl-schedules",
      "type": "rectangle",
      "x": 920,
      "y": 140,
      "width": 300,
      "height": 220,
      "backgroundColor": "#ebfbee",
      "strokeColor": "#2f9e44",
      "label": {
        "text": "SCHEDULES (Horarios / Turnos)\n-------------------------\n🔑 id : UUID (PK)\n🔗 professional_id : UUID (FK->prof.)\n📅 day_of_week : INT (0-6)\n⏰ start_time : TIME\n⏰ end_time : TIME\n⚡ active : BOOLEAN (true)"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T00:24:46.882Z",
      "updatedAt": "2026-08-15T00:24:46.882Z",
      "version": 1
    },
    {
      "id": "tbl-pets",
      "type": "rectangle",
      "x": 80,
      "y": 480,
      "width": 300,
      "height": 280,
      "backgroundColor": "#fff4e6",
      "strokeColor": "#e8590c",
      "label": {
        "text": "PETS (Mascotas / Pacientes)\n-------------------------\n🔑 id : UUID (PK)\n🔗 user_id : UUID (FK->users.id)\n🐾 name : VARCHAR\n🐕 species : VARCHAR\n🧬 breed : VARCHAR\n🎂 age : INT\n⚖️ weight : DECIMAL(5,2)\n🖼️ photo : VARCHAR\n⏱️ created_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T00:24:46.882Z",
      "updatedAt": "2026-08-15T00:24:46.882Z",
      "version": 1
    },
    {
      "id": "tbl-services",
      "type": "rectangle",
      "x": 920,
      "y": 480,
      "width": 300,
      "height": 260,
      "backgroundColor": "#e3fafc",
      "strokeColor": "#0c8599",
      "label": {
        "text": "SERVICES (Catálogo Clínico)\n-------------------------\n🔑 id : UUID (PK)\n📋 name : VARCHAR\n📝 description : TEXT\n⏳ duration : INT (Minutos)\n💵 price : DECIMAL(10,2) (USD)\n🏷️ category : ENUM ('consulta'...)\n⚡ active : BOOLEAN (true)\n⏱️ created_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T00:24:46.882Z",
      "updatedAt": "2026-08-15T00:24:46.882Z",
      "version": 1
    },
    {
      "id": "tbl-appointments",
      "type": "rectangle",
      "x": 480,
      "y": 440,
      "width": 340,
      "height": 340,
      "backgroundColor": "#f3d9fa",
      "strokeColor": "#9c36b5",
      "label": {
        "text": "APPOINTMENTS (Citas Médicas)\n-------------------------\n🔑 id : UUID (PK)\n🔗 user_id : UUID (FK->users.id)\n🔗 pet_id : UUID (FK->pets.id)\n🔗 professional_id : UUID (FK->prof.)\n🔗 service_id : UUID (FK->services.id)\n📅 date : DATE\n⏰ start_time : TIME\n⏰ end_time : TIME\n📊 status : ENUM ('pending', 'confirmed'...)\n📋 notes : TEXT\n⏱️ created_at : TIMESTAMP\n⏱️ updated_at : TIMESTAMP"
      },
      "roundness": {
        "type": 3
      },
      "fillStyle": "solid",
      "createdAt": "2026-08-15T00:24:46.882Z",
      "updatedAt": "2026-08-15T00:24:46.882Z",
      "version": 1
    },
