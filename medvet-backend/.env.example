# Servidor API
PORT=3030
HOST=0.0.0.0
NODE_ENV=production

# Base de Datos PostgreSQL
# En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://medvet_admin:medvet_secret_2026@localhost:5432/medvet

# Parámetros individuales alternativos para DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=medvet_admin
DB_PASSWORD=medvet_secret_2026
DB_DATABASE=medvet

# Redis (Caché & Sesiones)
# En Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379

# Autenticación JWT
FEATHERS_AUTH_SECRET=medvet_jwt_secret_production_2026_secure_key

# CORS Frontend
FRONTEND_URL=http://localhost:3000
