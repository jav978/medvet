{
  "name": "medvet-backend",
  "version": "1.0.0",
  "description": "MedVet Booking System API",
  "main": "lib/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "start": "node -r tsconfig/register lib/index.js",
    "build": "tsc",
    "test": "vitest test/**/*.test.ts",
    "migrate": "knex migrate:latest --knexfile src/knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile src/knexfile.ts",
    "seed": "knex seed:run --knexfile src/knexfile.ts"
  },
  "dependencies": {
    "@feathersjs/configuration": "^5.0.0",
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/express": "^5.0.0",
    "@feathersjs/feathers": "^5.0.0",
    "@feathersjs/knex": "^5.0.0",
    "@feathersjs/authentication": "^5.0.0",
    "@feathersjs/authentication-local": "^5.0.0",
    "@feathersjs/transport-commons": "^5.0.0",
    "@feathersjs/socketio": "^5.0.0",
    "knex": "^3.0.0",
    "pg": "^8.12.0",
    "ioredis": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "winston": "^3.11.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
