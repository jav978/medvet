{
  "name": "medvet-backend",
  "version": "1.0.0",
  "description": "MedVet Booking System API",
  "main": "lib/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "start": "node lib/index.js",
    "build": "tsc",
    "test": "vitest test/**/*.test.ts",
    "migrate": "ts-node ./node_modules/.bin/knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "ts-node ./node_modules/.bin/knex migrate:rollback --knexfile knexfile.ts",
    "seed": "ts-node ./node_modules/.bin/knex seed:run --knexfile knexfile.ts"
  },
  "dependencies": {
    "@feathersjs/authentication": "^5.0.0",
    "@feathersjs/authentication-local": "^5.0.0",
    "@feathersjs/configuration": "^5.0.0",
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/express": "^5.0.0",
    "@feathersjs/feathers": "^5.0.0",
    "@feathersjs/knex": "^5.0.0",
    "@feathersjs/socketio": "^5.0.0",
    "@feathersjs/transport-commons": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.0",
    "knex": "^3.0.0",
    "pg": "^8.12.0",
    "ts-node": "^10.9.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
